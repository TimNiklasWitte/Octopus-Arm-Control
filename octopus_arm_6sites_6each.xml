                  <geom fromto="0 0 0.10 0 0 -0.10" size="0.06 0.05"/>
                  <site name="s6_1" pos="0.06 0 0"/>
                  <site name="s6_2" pos="0.03 0.0520 0"/>
                  <site name="s6_3" pos="-0.03 0.0520 0"/>
                  <site name="s6_4" pos="-0.06 0 0"/>
                  <site name="s6_5" pos="-0.03 -0.0520 0"/>
                  <site name="s6_6" pos="0.03 -0.0520 0"/>

                  <body name="seg7" pos="0 0 -0.18">
                    <joint name="j7"/>
                    <geom fromto="0 0 0.09 0 0 -0.09" size="0.05 0.04"/>
                    <site name="s7_1" pos="0.05 0 0"/>
                    <site name="s7_2" pos="0.025 0.0433 0"/>
                    <site name="s7_3" pos="-0.025 0.0433 0"/>
                    <site name="s7_4" pos="-0.05 0 0"/>
                    <site name="s7_5" pos="-0.025 -0.0433 0"/>
                    <site name="s7_6" pos="0.025 -0.0433 0"/>

                    <body name="seg8" pos="0 0 -0.16">
                      <joint name="j8"/>
                      <geom fromto="0 0 0.08 0 0 -0.08" size="0.04 0.03"/>
                      <site name="s8_1" pos="0.04 0 0"/>
                      <site name="s8_2" pos="0.02 0.0346 0"/>
                      <site name="s8_3" pos="-0.02 0.0346 0"/>
                      <site name="s8_4" pos="-0.04 0 0"/>
                      <site name="s8_5" pos="-0.02 -0.0346 0"/>
