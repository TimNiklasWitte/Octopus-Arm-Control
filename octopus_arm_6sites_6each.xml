                      <body name="seg9" pos="0 0 -0.14">
                        <joint name="j9"/>
                        <geom fromto="0 0 0.07 0 0 -0.07" size="0.03 0.02"/>
                        <site name="s9_1" pos="0.03 0 0"/>
                        <site name="s9_2" pos="0.015 0.0260 0"/>
                        <site name="s9_3" pos="-0.015 0.0260 0"/>
                        <site name="s9_4" pos="-0.03 0 0"/>
                        <site name="s9_5" pos="-0.015 -0.0260 0"/>
                        <site name="s9_6" pos="0.015 -0.0260 0"/>

                        <body name="seg10" pos="0 0 -0.12">
                          <joint name="j10"/>
                          <geom fromto="0 0 0.06 0 0 -0.06" size="0.02 0.01"/>
                          <site name="tip" pos="0 0 -0.06" size="0.015" rgba="1 0 0 1"/>
                          <site name="s10_1" pos="0.02 0 0"/>
                          <site name="s10_2" pos="0.01 0.0173 0"/>
                          <site name="s10_3" pos="-0.01 0.0173 0"/>
                          <site name="s10_4" pos="-0.02 0 0"/>
                          <site name="s10_5" pos="-0.01 -0.0173 0"/>
                          <site name="s10_6" pos="0.01 -0.0173 0"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <site name="tgt" type="sphere" size="0.05" pos="0.05 0 0.5" rgba="0 255 0 1"/>
  </worldbody>

