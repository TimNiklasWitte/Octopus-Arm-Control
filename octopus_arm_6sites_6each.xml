<mujoco model="octopus_arm">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 0" timestep="0.001" integrator="RK4"/>

  <visual>
    <global offwidth="1440" offheight="768" azimuth="90" elevation="-45"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="base_mat" rgba="0.2 0.2 0.2 1"/>
    <material name="segment_mat" rgba="0.8 0.3 0.3 0.7"/>
  </asset>

  <default>
    <geom type="cylinder" material="segment_mat" condim="3" density="500"/> 
    <joint type="ball" armature="0.01" damping="0.5" stiffness="0.1"/>
    <general dyntype="muscle" gaintype="muscle" biastype="muscle" ctrlrange="0 1"/>
  </default>

  <worldbody>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" pos="0 0 -2" size="10 10 0.1" material="groundplane"/>
    <camera name="front" pos="3.5 0 0.2" xyaxes="0 1 0 0 0 1"/>
    <body name="base" pos="0 0 1">
      <geom type="sphere" size="0.12" material="base_mat"/>
      
      <body name="seg1" pos="0 0 -0.15">
        <joint name="j1"/>
        <geom fromto="0 0 0.15 0 0 -0.15" size="0.11 0.10"/>
        <site name="s1_1" pos="0.11 0 0"/>
        <site name="s1_2" pos="0.055 0.0953 0"/>
        <site name="s1_3" pos="-0.055 0.0953 0"/>
        <site name="s1_4" pos="-0.11 0 0"/>
        <site name="s1_5" pos="-0.055 -0.0953 0"/>
        <site name="s1_6" pos="0.055 -0.0953 0"/>

        <body name="seg2" pos="0 0 -0.28">
          <joint name="j2"/>
          <geom fromto="0 0 0.14 0 0 -0.14" size="0.10 0.09"/>
          <site name="s2_1" pos="0.10 0 0"/>
          <site name="s2_2" pos="0.05 0.0866 0"/>
          <site name="s2_3" pos="-0.05 0.0866 0"/>
          <site name="s2_4" pos="-0.10 0 0"/>
          <site name="s2_5" pos="-0.05 -0.0866 0"/>
          <site name="s2_6" pos="0.05 -0.0866 0"/>

          <body name="seg3" pos="0 0 -0.26">
            <joint name="j3"/>
            <geom fromto="0 0 0.13 0 0 -0.13" size="0.09 0.08"/>
            <site name="s3_1" pos="0.09 0 0"/>
            <site name="s3_2" pos="0.045 0.0779 0"/>
            <site name="s3_3" pos="-0.045 0.0779 0"/>
            <site name="s3_4" pos="-0.09 0 0"/>
            <site name="s3_5" pos="-0.045 -0.0779 0"/>
            <site name="s3_6" pos="0.045 -0.0779 0"/>

            <body name="seg4" pos="0 0 -0.24">
              <joint name="j4"/>
              <geom fromto="0 0 0.12 0 0 -0.12" size="0.08 0.07"/>
              <site name="s4_1" pos="0.08 0 0"/>
              <site name="s4_2" pos="0.04 0.0693 0"/>
              <site name="s4_3" pos="-0.04 0.0693 0"/>
              <site name="s4_4" pos="-0.08 0 0"/>
              <site name="s4_5" pos="-0.04 -0.0693 0"/>
              <site name="s4_6" pos="0.04 -0.0693 0"/>

              <body name="seg5" pos="0 0 -0.22">
